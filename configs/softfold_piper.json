{
  "task": "fold the cloth",
  "dataset_format": "lerobot",
  "repo_id": "local/softfold_piper_v2",
  "root": "data/lerobot",
  "robot_type": "piper",
  "no_videos": false,
  "prompt_outcome": true,
  "episode_outcome": "skip",
  "output_dir": "data/raw",
  "fps": 20.0,
  "duration": null,
  "follower_left_can": "can2",
  "follower_right_can": "can0",
  "leader_left_can": "can2",
  "leader_right_can": "can0",
  "camera_width": 640,
  "camera_height": 480,
  "camera_fps": 30,
  "image_format": "jpg",
  "image_quality": 95,
  "action_source": "leader",
  "recording_notes": "SoftFold 本地真机关节空间录制。相机名用 soft-fold 同构：cam_high / cam_left_wrist / cam_right_wrist。训练默认 Soft Prompt PEFT（stage1）。",
  "training": {
    "policy_type": "xvla",
    "job_name": "softfold_piper_stage1",
    "output_dir": "outputs/train/softfold_piper_stage1",
    "policy_path": "lerobot/xvla-soft-fold",
    "dtype": "bfloat16",
    "action_mode": "auto",
    "max_action_dim": 20,
    "chunk_size": 16,
    "n_action_steps": 16,
    "num_denoising_steps": 10,
    "use_proprio": true,
    "freeze_vision_encoder": true,
    "freeze_language_encoder": true,
    "train_policy_transformer": false,
    "train_soft_prompts": true,
    "normalization_mapping": {
      "ACTION": "IDENTITY",
      "STATE": "IDENTITY",
      "VISUAL": "IDENTITY"
    },
    "rename_map": {
      "observation.images.cam_high": "observation.images.image",
      "observation.images.cam_left_wrist": "observation.images.image2",
      "observation.images.cam_right_wrist": "observation.images.image3",
      "observation.images.cam_right": "observation.images.image",
      "observation.images.cam_top": "observation.images.image2",
      "observation.images.cam_left": "observation.images.image3"
    },
    "device": "cuda",
    "steps": 5000,
    "batch_size": 1,
    "num_workers": 2,
    "log_freq": 50,
    "save_freq": 1000,
    "wandb_enable": false,
    "video_backend": "pyav",
    "outcome_filter": "exclude-failures",
    "include_unknown": false,
    "exclude_unlabeled": true,
    "push_to_hub": false,
    "pytorch_alloc_conf": "expandable_segments:True,max_split_size_mb:128"
  },
  "policy_live": {
    "policy_path": "outputs/train/softfold_piper_stage1/checkpoints/last/pretrained_model",
    "repo_id": "local/softfold_piper_v2",
    "dataset_root": "data/lerobot/local/softfold_piper_v2",
    "video_backend": "pyav",
    "device": "cuda",
    "inference_dtype": "bfloat16",
    "num_inference_steps": 10,
    "execute": false,
    "duration": 180.0,
    "fps": 20.0,
    "control_speed": 30,
    "max_joint_step_rad": 0.03,
    "max_gripper_step_m": 0.002,
    "gripper_effort": 1000,
    "smoothing_alpha": 0.20,
    "pace_by_reach": false,
    "advance_threshold_rad": 0.08,
    "max_hold_steps": 30,
    "print_every": 1,
    "log_jsonl": ""
  },
  "cameras": [
    {"name": "cam_high", "ref": 14},
    {"name": "cam_left_wrist", "ref": 20},
    {"name": "cam_right_wrist", "ref": 16}
  ],
  "preprocessing": {
    "enabled": false
  },
  "deployment": {
    "notes": "GPU 服务器(A600)跑 X-VLA Policy Server；工控机跑 SSH 隧道 + Robot Client。仓库在 /data/yangjingwen/code/SoftFold。",
    "gpu_server": {
      "ssh_host": "A600",
      "repo_root": "/data/yangjingwen/code/SoftFold",
      "run_script": "scripts/start_policy_server_xvla.sh"
    },
    "robot_ipc": {
      "repo_root": "/home/agilex/code/yjw/SoftFold",
      "tunnel_script": "scripts/ssh_tunnel_policy_server.sh",
      "client_script": "scripts/run_async_policy_client_xvla.sh"
    }
  },
  "policy_server": {
    "host": "0.0.0.0",
    "port": 8080,
    "fps": 20,
    "inference_latency": 0.2,
    "obs_queue_timeout": 15,
    "inference_dtype": "bfloat16",
    "num_inference_steps": 10,
    "preload_at_startup": true,
    "policy_type": "xvla",
    "actions_per_chunk": 16
  },
  "remote_gpu": {
    "ssh_host": "A600",
    "gpu_repo_root": "/data/yangjingwen/code/SoftFold",
    "conda_env": "piper",
    "use_ssh_tunnel": true,
    "tunnel_local_port": 8080,
    "tunnel_remote_host": "127.0.0.1",
    "tunnel_remote_port": 8080
